## Copy this file to `config/.env` and fill with your Kotak Neo credentials
# Keep `PAPER_TRADING_MODE=true` while testing to avoid live orders.

KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=   # optional: only needed for v1 login flow
KOTAK_NEOFINK=           # optional: only if your Kotak Neo setup requires a separate NeoFinKey
KOTAK_MOBILE=            # the mobile number registered to your Kotak Neo account
KOTAK_UCC=               # Unique Client Code from Kotak Neo profile; required for v2 TOTP login
KOTAK_PASSWORD=          # the password you use to log in to the Kotak Neo app
KOTAK_MPIN=              # 6-digit Neo app MPIN; this is not the authenticator TOTP
# Optional: base32 TOTP seed (e.g. JBSWY3DPEHPK3PXP) from your authenticator's
# QR setup. When set, login is fully automatic — no manual code entry needed,
# safe for unattended scheduling. Leave blank to log in interactively once at
# startup (you'll paste the 6-digit code from your authenticator).
KOTAK_TOTP_SEED=
KOTAK_ENVIRONMENT=prod   # set to 'uat' if your key is for the Kotak Neo UAT sandbox

# When true, the live connector will not place real orders.
# This is the default — the system only ever paper-trades on live data.
PAPER_TRADING_MODE=true

## Data source mode
# Leave unset (or blank) to use LIVE Kotak quotes when credentials are present.
# Set to "true" to force the mock connector (fake prices, no login needed).
# Can be overridden per-run by the --mock / --live CLI flags on api_server.
# PIVOTBOSS_MOCK=

## WhatsApp alerts via CallMeBot (optional)
# Setup:
#   1. Add +34 600 21 25 47 as a WhatsApp contact (CallMeBot).
#   2. Send it: I allow callmebot to send me messages
#   3. Copy the API key it sends back here.
WHATSAPP_NUMBER=        # your number, international, digits only — e.g. 919876543210
WHATSAPP_APIKEY=        # key from CallMeBot

## SQLite persistence (Phase 2.5)
# Default DB location is data/pivotboss.db (gitignored). Override only if you
# want the DB elsewhere (e.g. an external backup drive).
PIVOTBOSS_DB_PATH=

## Scheduler (Phase 2.1)
# Set to "false" to disable the automated daily trading cycle while keeping
# the API server running.
SCHEDULER_ENABLED=true

## Alert channel
# "console" (default — prints to terminal) or "whatsapp" (needs WHATSAPP_* vars).
ALERT_CHANNEL=console

# Set to true to require 15-min candle breakout confirmation before auto-trading
USE_BREAKOUT_CONFIRM=false
