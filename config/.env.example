# ─────────────────────────────────────────────────────────────
#  PivotBoss AI — Configuration File
#  Copy this to config/.env and fill your real values
#  NEVER commit the real .env file to GitHub!
# ─────────────────────────────────────────────────────────────

# ── KOTAK NEO API CREDENTIALS ─────────────────────────────────
# Get these from: Kotak Neo App → Invest → Trade API → Generate App
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_MOBILE=your_10_digit_mobile_number
KOTAK_PASSWORD=your_kotak_neo_password
KOTAK_MPIN=your_6_digit_mpin

# ── TRADING MODE ──────────────────────────────────────────────
# Keep this TRUE until you are confident the strategy works!
PAPER_TRADING_MODE=true

# ── RISK SETTINGS ─────────────────────────────────────────────
MAX_RISK_PER_TRADE_PCT=1.0       # Max 1% of capital at risk per trade
MAX_OPEN_POSITIONS=3             # Never hold more than 3 positions
MAX_DAILY_LOSS_PCT=3.0           # Stop trading if daily loss > 3%
MIN_SIGNAL_STRENGTH=7            # Only take trades with strength >= 7

# ── WATCHLIST ─────────────────────────────────────────────────
WATCHLIST=NIFTY,BANKNIFTY,RELIANCE,HDFCBANK,TCS

# ── FUTURE: ZERODHA (Phase 2) ─────────────────────────────────
# ZERODHA_API_KEY=your_key
# ZERODHA_API_SECRET=your_secret
# ZERODHA_USER_ID=your_user_id
